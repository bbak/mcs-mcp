# MCS-MCP configuration
#
# Generated from internal/config/template.go - do not edit by hand.
# This file is created once and never overwritten, so your edits are safe.
#
# Precedence, highest first:
#   1. process environment
#   2. this file
#   3. .env next to the binary
#   4. .env in the working directory
#   5. built-in defaults (shown below)

#
# Jira instance to connect to
#
# Base URL of your Jira instance.
# Example: https://your-domain.atlassian.net
JIRA_URL=

#
# Authentication: 3 options
#
# Token type. Leave unset to infer it: JIRA_USER_EMAIL set means "api"
# (Atlassian Cloud), otherwise "pat" (Data Center/Server).
# Set explicitly to override:
#   pat - Personal Access Token, Data Center/Server only
#   api - API Token, Atlassian Cloud only
# JIRA_TOKEN_TYPE=

# The token itself.
JIRA_TOKEN=

# Your Jira account e-mail. Required for Atlassian Cloud API tokens,
# leave empty for Data Center/Server with a PAT.
JIRA_USER_EMAIL=

# 3rd option: session cookies, for locked-down Data Center instances.
# JIRA_XSRF_TOKEN=

# JIRA_SESSION_ID=

# JIRA_REMEMBERME_COOKIE=

# Optional cookies for a Google Cloud Load Balancer.
# JIRA_GCILB=

# JIRA_GCLB=

#
# Jira REST API behaviour
#
# Enforced delay between requests to the Jira REST API.
JIRA_REQUEST_DELAY_SECONDS=10

#
# Diagnostics
#
# Writes considerably more detail to the logfile.
VERBOSE=false

#
# Data location
#
# Base folder for logs and cache.
# NOTE: setting this here has NO EFFECT. The data path must be known
# before this file can be found, so it is read only from the
# --data-path flag or the DATA_PATH environment variable.
# Listed here for discoverability only.
# DATA_PATH=

#
# Flow metrics
#
# Reset the clock when an item backflows past the commitment point.
# Applies to both Cycle Time and WIP Age to keep them in sync.
# When true, backflowed items have their age recalculated from the
# last backflow date forward. Set to false to keep cumulative age.
COMMITMENT_POINT_BACKFLOW_RESET_CLOCK=true

#
# Simulation engine
#
# Engine selection: "crude", "bbak" (regime-aware sampling), or
# "auto" (backtest-driven). See docs/architecture.md 4.6-4.8.
# MCS_ENGINE=crude

# Per-engine weights (0 = disabled, 1-100 = enabled with tiebreak
# priority). Used by "auto" to break ties when two engines have
# identical backtest accuracy.
# MCS_ENGINE_CRUDE=50

# MCS_ENGINE_BBAK=50

#
# Chart rendering
#
# Number of recent tool results kept for on-demand chart rendering.
# 0 = disabled (no HTTP server). 1-100 = enabled. Values above 100
# are rejected at startup. When enabled the server listens on a
# local port for chart requests.
MCS_CHARTS_BUFFER_SIZE=20

#
# Initial Jira hydration
#
# Hydration window (months). The hydration JQL fetches all issues
# updated within INGESTION_UPDATED_LOOKBACK months OR created within
# INGESTION_CREATED_LOOKBACK months. The created clause keeps
# long-lived items whose last update fell outside the updated window.
INGESTION_UPDATED_LOOKBACK=24

INGESTION_CREATED_LOOKBACK=36

# Hard ceiling on items pulled during initial hydration. Paging stops
# once the running total reaches this value. Forward catch-up
# (import_history_update) is not subject to this cap.
INGESTION_MAX_ITEMS=5000
