{
  "permissions": {
    "allow": []
  },
  "enabledPlugins": {},
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.go) gofmt -w \"$(printf \"%s\" \"$f\" | tr \"\\\\\\\\\" \"/\")\";; esac",
            "statusMessage": "gofmt"
          }
        ]
      }
    ]
  }
}
